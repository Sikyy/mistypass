# MistyPass — Development Environment Variables
# Copy this file to .env and customize values before running docker-compose.
#
#   cp .env.example .env
#
# IMPORTANT: Never commit .env to version control.

# --- Database ---
POSTGRES_PASSWORD=change-me-postgres-password

# --- Redis ---
REDIS_PASSWORD=change-me-redis-password

# --- Gateway ---
GATEWAY_BOOTSTRAP_TOKEN=change-me-bootstrap-token
# Optional gateway-only mTLS listener. Enable in production when gateways should
# authenticate with client certificates instead of only bearer device tokens.
# GATEWAY_MTLS_ADDR=:9443
# GATEWAY_MTLS_SERVER_CERT_PEM="-----BEGIN CERTIFICATE-----..."
# GATEWAY_MTLS_SERVER_KEY_PEM="-----BEGIN EC PRIVATE KEY-----..."
# GATEWAY_CA_CERT_PEM="-----BEGIN CERTIFICATE-----..."
# GATEWAY_CA_KEY_PEM="-----BEGIN EC PRIVATE KEY-----..."

# --- EMQX (MQTT Broker Dashboard) ---
EMQX_DASHBOARD_USERNAME=admin
EMQX_DASHBOARD_PASSWORD=change-me-emqx-password

# --- Timezone ---
TZ=Asia/Jakarta
DEFAULT_TIMEZONE=Asia/Jakarta

# --- Frontend CORS (comma-separated origins) ---
# CORS_ORIGIN=http://localhost:5173

# --- NATS ---
# NATS_ENABLED=true

# --- Demo users (set to true only for demos) ---
# ENABLE_DEMO_USERS=false

# --- WhatsApp Business API (Meta Cloud API) ---
# Provider: "mock" (default, no real messages) or "meta" (real delivery)
WALLET_ALERT_WHATSAPP_PROVIDER=meta
# Your access token from Meta App Dashboard → WhatsApp → API Setup
WALLET_ALERT_WHATSAPP_API_KEY=your_access_token_here
# Phone Number ID from Meta App Dashboard → WhatsApp → API Setup
WALLET_ALERT_WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
# Receiver groups: group_name=phone1,phone2;group_name2=phone3
# Phone numbers must include country code without + (e.g. 6281234567890)
WALLET_ALERT_WHATSAPP_RECEIVER_MAP=security=6281234567890;ops=6289876543210
# Optional: API endpoint override (default: https://graph.facebook.com/v22.0)
# WALLET_ALERT_WHATSAPP_ENDPOINT=https://graph.facebook.com/v22.0
# Optional: request timeout (default: 5s)
# WALLET_ALERT_WHATSAPP_TIMEOUT=5s
# Optional: use approved template instead of plain text (production recommended)
# WALLET_ALERT_WHATSAPP_TEMPLATE_NAME=access_denied_alert
# WALLET_ALERT_WHATSAPP_TEMPLATE_LANG=en_US

# --- Lark Integration ---
# LARK_APP_ID=cli_xxxxxxxxxx
# LARK_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxx
# Lark Bot webhook for alert dispatch (triggers on access denied, door held open, etc.)
# LARK_ALERT_WEBHOOK_URL=https://open.larksuite.com/open-apis/bot/v2/hook/xxx
