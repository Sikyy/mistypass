# MistyPass Mac mini staging env template.
# Copy to .env.staging on the Mac mini and replace all change-me / replace-* values.
# Keep the real file on the Mac mini only; .env.staging is ignored by git.

APP_ENV=staging
TZ=Asia/Jakarta
DEFAULT_TIMEZONE=Asia/Jakarta
ENABLE_DEMO_USERS=true
CORS_ORIGIN=https://staging-admin.mistyislet.com

POSTGRES_PASSWORD=change-me-strong-staging-postgres-password
REDIS_PASSWORD=change-me-strong-staging-redis-password
JWT_SECRET=change-me-fixed-random-long-secret
HRIS_VAULT_MASTER_KEY=change-me-fixed-random-vault-key
GATEWAY_BOOTSTRAP_TOKEN=change-me-fixed-random-bootstrap-token

GATEWAY_REQUIRE_REQUEST_NONCE=false
GATEWAY_WS_MAX_SESSION_TTL=6h
NATS_ENABLED=true

# Cloudflare Email Service. Replace account/token/receivers before email smoke.
REPORT_EMAIL_ENABLED=true
MAIL_PROVIDER=cloudflare
CLOUDFLARE_ACCOUNT_ID=replace-with-cloudflare-account-id
CLOUDFLARE_EMAIL_API_TOKEN=replace-only-on-macmini
CLOUDFLARE_EMAIL_TIMEOUT=5s
REPORT_EMAIL_FROM=reports@mistyislet.com
USER_INVITATION_EMAIL_PROVIDER=cloudflare
USER_INVITATION_EMAIL_FROM=no-reply@mistyislet.com
WALLET_ALERT_EMAIL_PROVIDER=cloudflare
WALLET_ALERT_EMAIL_FROM=no-reply@mistyislet.com
WALLET_ALERT_EMAIL_RECEIVER_MAP=security=security@mistyislet.com;ops=ops@mistyislet.com

# Keep WhatsApp mocked until Meta production approval and templates are ready.
WALLET_ALERT_WHATSAPP_PROVIDER=mock

# Optional camera/Hikvision staging toggles.
CAMERA_ENABLED=false
CAMERA_VAULT_MASTER_KEY=
CAMERA_SNAPSHOT_TIMEOUT=10
CAMERA_SNAPSHOT_RETENTION_DAYS=30
CAMERA_MAX_SNAPSHOTS_PER_EVENT=3
HIK_ISC_ENABLED=false
HIK_ISC_HOST=https://open.hikconnect.com
HIK_ISC_APP_KEY=
HIK_ISC_APP_SECRET=

# Optional platform features.
OAUTH2_ENABLED=false
EXTERNAL_AUTH_ENABLED=false
UPLOAD_STORAGE_DIR=
UPLOAD_SIGNING_KEY=
EMAIL_INBOUND_WEBHOOK_SECRET=
