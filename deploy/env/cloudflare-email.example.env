# MistyPass Cloudflare Email Service env template.
# Copy these lines into the Mac mini .env.staging/.env.production file and
# replace placeholders there. Do not commit real API tokens.

REPORT_EMAIL_ENABLED=true
MAIL_PROVIDER=cloudflare
CLOUDFLARE_ACCOUNT_ID=replace-with-cloudflare-account-id
CLOUDFLARE_EMAIL_API_TOKEN=replace-only-on-macmini
CLOUDFLARE_EMAIL_TIMEOUT=5s

REPORT_EMAIL_FROM=reports@mistyislet.com
USER_INVITATION_EMAIL_PROVIDER=cloudflare
USER_INVITATION_EMAIL_FROM=no-reply@mistyislet.com

WALLET_ALERT_EMAIL_PROVIDER=cloudflare
WALLET_ALERT_EMAIL_FROM=no-reply@mistyislet.com
WALLET_ALERT_EMAIL_RECEIVER_MAP=security=security@mistyislet.com;ops=ops@mistyislet.com
WALLET_ALERT_WHATSAPP_PROVIDER=mock
